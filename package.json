{
  "name": "terminal-port-title",
  "displayName": "Terminal Port Title",
  "description": "Renames a terminal to <folder>:<port> when a command prints the port it is listening on.",
  "version": "0.0.3",
  "publisher": "arxpw",
  "license": "UNLICENSED",
  "private": true,
  "repository": { "type": "git", "url": "local" },
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Terminal Port Title",
      "properties": {
        "terminalPortTitle.patterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "\"port\"\\s*:\\s*\"?(\\d{2,5})\"?",
            "Local:\\s+https?://[^\\s/:]+:(\\d{2,5})"
          ],
          "markdownDescription": "Regexes used to find the port in terminal output, tried in order. Capture group 1 must be the port. Defaults cover `\"port\": \"1234\"` JSON logs and the `Local: http://localhost:3000` line printed by Next.js / Vite."
        },
        "terminalPortTitle.format": {
          "type": "string",
          "default": "${port}",
          "description": "Terminal name template. Supports ${folder} and ${port}."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npm run compile && vsce package --allow-missing-repository --skip-license",
    "install-local": "npm run package && code --install-extension terminal-port-title-$npm_package_version.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
